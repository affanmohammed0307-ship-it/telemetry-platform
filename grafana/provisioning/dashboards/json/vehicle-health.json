{
  "title": "Vehicle Health Monitor",
  "uid": "vehicle-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Engine Temperature (°C)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "fieldConfig": {
        "defaults": { "unit": "celsius", "custom": { "drawStyle": "line", "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp AS time, value AS \"engine_temp\" FROM sensor_readings WHERE sensor_id = 'engine_temp' AND $__timeFilter(timestamp) ORDER BY timestamp",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Battery Voltage (V)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "fieldConfig": {
        "defaults": { "unit": "volt", "custom": { "drawStyle": "line", "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp AS time, value AS \"battery_voltage\" FROM sensor_readings WHERE sensor_id = 'battery_voltage' AND $__timeFilter(timestamp) ORDER BY timestamp",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alerts (last 15m)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "rawSql": "SELECT timestamp AS time, sensor_id, value, alert FROM sensor_readings WHERE alert IS NOT NULL AND $__timeFilter(timestamp) ORDER BY timestamp DESC LIMIT 100",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Critical Alert Count (last 15m)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 1 },
          { "color": "red", "value": 5 }
        ] } },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value FROM sensor_readings WHERE alert LIKE '%CRITICAL%' AND $__timeFilter(timestamp)",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}
